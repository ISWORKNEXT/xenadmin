{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xen Desktop",
  "version": "0.1.0",
  "identifier": "studio.drite.xen-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Xen Desktop", "width": 1440, "height": 940, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
